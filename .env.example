# Study Platform — configuración de ejemplo para el backend Zig.
# Copia este fichero a .env y reemplaza los valores de ejemplo.
# Nunca guardes secretos reales en Git.
# Fuente de verdad: src/config.zig. SESSION_SECRET debe tener al menos 32 caracteres.

# --- Servidor ---
# --addr controla la dirección de escucha (default 0.0.0.0:8090).
# HOST/PORT se mantienen para compatibilidad y para mostrar la configuración.
HOST=127.0.0.1
PORT=8090

# --- Sesión y autenticación ---
# Genera un valor aleatorio con: openssl rand -hex 32
SESSION_SECRET=cambia_esto_por_un_secreto_aleatorio_de_32_caracteres
# true desactiva el login: sólo para desarrollo local, nunca en producción.
AUTH_DISABLED=false
# Sin REGISTRATION_TOKEN, POST /register permanece deshabilitado.
REGISTRATION_TOKEN=

# --- SQLite y notas ---
DB_PATH=./data/app.db
NOTES_DIR=./notes
# Vault de Obsidian para sincronizar (POST /api/notes/sync-vault). Si se omite,
# usa $HOME/SegundoCerebro. La BD es la fuente de verdad; los .md del vault se
# importan y se reflejan como espejo en NOTES_DIR.
VAULT_DIR=
# La build usa libsqlite3 del sistema (con FTS5 habilitado).

# --- OpenRouter (opcional) ---
# Vacío = modo simulado; no se realizan peticiones externas ni cargos.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=cohere/north-mini-code:free
OPENROUTER_MAX_TOKENS=8192
OPENROUTER_MAX_COST_USD=2.0

# --- Integración MCP ---
# URL de Mikareno (las vistas académicas muestran estado vacío si no responde).
MIKARENO_MCP_URL=http://127.0.0.1:8080/mcp
GENOFFICE_MCP_URL=http://127.0.0.1:8453/mcp
# Optional shared output directory for GenOffice DOCX reports.
GENOFFICE_WORK_DIR=
GENOFFICE_TIMEOUT_MS=90000
# El servidor MCP propio está deshabilitado si esta clave está vacía.
CUSTOM_MCP_API_KEY=
MCP_TIMEOUT_MS=5000

# Reservado para configuración de SQLite; el runtime Zig actual usa una
# conexión FULLMUTEX y no mantiene un pool de conexiones.
DB_MAX_CONNECTIONS=4
