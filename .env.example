# Study Platform — plantilla de configuración (.env)
# Uso:  cp .env.example .env   y luego rellena lo que necesites.
# NUNCA subas el .env real a git (ya está en .gitignore).
# Fuente de verdad de estas variables: src/config.rs (Config::from_env).
# Genera el secreto de sesión con:  openssl rand -hex 32

# --- Servidor ---
# HOST — interfaz que reporta la app; con 127.0.0.1 marca "is_localhost" en la UI.
# Default: 127.0.0.1
# OJO: el bind real lo decide la CLI (--addr, por defecto 0.0.0.0:8090), no HOST/PORT.
HOST=127.0.0.1
# PORT — puerto que se muestra en el panel MCP. Default: 8090
# OJO: el puerto real de escucha viene de --addr, no de esta variable.
PORT=8090

# --- Secreto de sesión (OBLIGATORIO) ---
# Única variable obligatoria: sin ella la app no arranca.
# Debe tener >= 32 caracteres o la app falla con "Invalid value for SESSION_SECRET".
# Generar con: openssl rand -hex 32
SESSION_SECRET=cambia_esto_por_32_caracteres_aleatorios

# --- Base de datos ---
# Ruta del archivo SQLite. Default: ./data/app.db
DB_PATH=./data/app.db

# --- Notas ---
# Carpeta con las notas en markdown. Default: ./notes
NOTES_DIR=./notes

# --- OpenRouter (IA de la app) ---
# Opcional. Sin clave (o con valor vacío) la app arranca en MODO DEMO:
# sin generación de material ni chat con IA. Default: sin clave
# Clave propia de esta app, distinta de la de OpenCode (https://openrouter.ai/keys).
OPENROUTER_API_KEY=
# Modelo usado por la app. Default: cohere/north-mini-code:free
# Ejemplo de alternativa gratuita: minimax/minimax-m3.1-flash:free
OPENROUTER_MODEL=cohere/north-mini-code:free
# Tope de tokens por respuesta. Default: 8192
OPENROUTER_MAX_TOKENS=8192
# Presupuesto máximo de gasto en USD (suma del mes actual). Default: 2.0
# Alcanzado el tope, la app deja de llamar al proveedor (error de presupuesto).
OPENROUTER_MAX_COST_USD=2.0

# --- MCP ---
# Mikareno MCP (datos escolares).
# Se usa si el host es loopback, una dirección privada (RFC 1918) o CGNAT
# 100.64/10 — el rango que Tailscale asigna a los nodos de la tailnet, que es
# como la app de producción alcanza el MCP que vive en otro equipo.
# Cualquier host PÚBLICO se ignora a propósito (el cliente es de sólo lectura,
# pero no debe apuntar a un MCP de terceros por accidente).
# Default: http://127.0.0.1:8080/mcp
MIKARENO_MCP_URL=http://127.0.0.1:8080/mcp
# GenOffice MCP (documentos). Se sondea por HTTP JSON-RPC; vacío = deshabilitado.
# Default: http://127.0.0.1:8453/mcp
GENOFFICE_MCP_URL=http://127.0.0.1:8453/mcp
# Clave del MCP propio de la app. Opcional: si no se define, el MCP propio queda
# deshabilitado (custom_mcp_enabled = false). Default: sin clave
CUSTOM_MCP_API_KEY=

# --- Autenticación ---
# AUTH_DISABLED — activa el modo "sin login". Default: false
# Valores true/1/yes/on = la app NO pide contraseña: cualquiera con acceso a la
# red (Tailscale/LAN) entra con todos los permisos. Úsalo SOLO en desarrollo;
# en producción déjalo en false.
AUTH_DISABLED=false

# --- Logs ---
# Filtro de tracing. Default: study_platform=info,tower_http=info
RUST_LOG=study_platform=info,tower_http=info
