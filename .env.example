# Study Platform — Configuration Template
# Copy to .env and fill in values. NEVER commit .env to git.
# Generate secrets with: openssl rand -hex 32

# --- Server ---
PORT=8090
HOST=127.0.0.1

# --- Secrets (REQUIRED — generate with `openssl rand -hex 32`) ---
SESSION_SECRET=replace_me_with_32_byte_hex

# --- Database ---
DB_PATH=/home/gabo/study-platform/data/app.db

# --- Notes ---
NOTES_DIR=/home/gabo/study-platform/notes

# --- OpenRouter (application LLM — SEPARATE key from OpenCode) ---
# Get key from: https://openrouter.ai/keys
# Budget: $2.00 USD/month maximum
OPENROUTER_API_KEY=sk-or-replace-with-your-key
OPENROUTER_MODEL=cohere/north-mini-code:free
OPENROUTER_MAX_TOKENS=8192
OPENROUTER_MAX_COST_USD=2.0

# --- MCP endpoints (localhost only on remote) ---
# Mikareno MCP — will be migrated to remote (127.0.0.1:8080/mcp)
# Currently only runs on asus-tuf: http://100.115.62.97:8080/mcp
MIKARENO_MCP_URL=http://127.0.0.1:8080/mcp
# GenOffice MCP — already running on remote (port 8453)
GENOFFICE_MCP_URL=http://127.0.0.1:8453/mcp
# Custom MCP Server (this application's own MCP — for future use)
CUSTOM_MCP_API_KEY=replace_me_with_32_byte_hex

# --- Logging ---
RUST_LOG=study_platform=info,tower_http=info
